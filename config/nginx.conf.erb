server {
    listen <%= ENV["PORT"] %>;
    server_name _;
    root .;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|webp|mp4|webm|mov)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(html)$ {
        add_header Cache-Control "public, max-age=3600";
    }
}